{
  "norms": {
    "_comment": "This project's rules for the coding agent. A rule with 'patterns' is checked by regex; a rule with only a 'statement' is judged by the model. Severity is set here by a human, never by the model. Edit freely - this is data, not code.",
    "rules": [
      {
        "id": "no-hardcoded-credentials",
        "statement": "Never commit a real API key, token, or password. Read them from the environment or a secrets manager.",
        "severity": "BLOCKED",
        "patterns": [
          "\\bsk-[A-Za-z0-9]{20,}",
          "\\bAKIA(?![0-9A-Z]*EXAMPLE\\b)[0-9A-Z]{16}\\b",
          "\\bghp_[A-Za-z0-9]{30,}",
          "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
          "-----BEGIN [A-Z ]*PRIVATE KEY-----"
        ],
        "except_paths": [
          "test_*",
          "*_test.*",
          "tests/*",
          "*/tests/*",
          "spec/*",
          "*.spec.*",
          "*.test.*",
          "*/fixtures/*",
          "*/__mocks__/*",
          "*.md",
          "*.rst",
          "*.txt"
        ]
      },
      {
        "id": "no-secrets-assigned-inline",
        "statement": "Secrets must not be assigned as string literals in source; load them from configuration.",
        "severity": "FLAGGED",
        "patterns": [
          "(?i)\\b(api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)\\s*[:=]\\s*[\\\"'](?=[^\\\"']*[0-9])[^\\\"'\\s]{12,}[\\\"']"
        ],
        "except_paths": [
          "test_*",
          "*_test.*",
          "tests/*",
          "*/tests/*",
          "spec/*",
          "*.spec.*",
          "*.test.*",
          "*/fixtures/*",
          "*/__mocks__/*",
          "*.md",
          "*.rst",
          "*.txt"
        ]
      },
      {
        "id": "no-wildcard-cors",
        "statement": "Do not open CORS to every origin. Name the origins that are allowed.",
        "severity": "FLAGGED",
        "patterns": [
          "(?i)access-control-allow-origin[\\\"']?\\s*[:,=]\\s*[\\\"']\\*[\\\"']",
          "(?i)\\ballow_origins\\s*=\\s*\\[\\s*[\\\"']\\*[\\\"']"
        ],
        "except_paths": [
          "test_*",
          "*_test.*",
          "tests/*",
          "*/tests/*",
          "spec/*",
          "*.spec.*",
          "*.test.*",
          "*/fixtures/*",
          "*/__mocks__/*",
          "*.md",
          "*.rst",
          "*.txt"
        ]
      },
      {
        "id": "no-inline-prompts",
        "statement": "System prompts belong in one named place, not scattered inline through the code.",
        "severity": "FLAGGED"
      },
      {
        "id": "no-debug-output",
        "statement": "Take debugging statements out before the change is done.",
        "severity": "FLAGGED",
        "patterns": [
          "\\bconsole\\.log\\s*\\(",
          "^\\s*debugger\\s*;?\\s*$",
          "\\bbreakpoint\\s*\\(\\s*\\)",
          "\\bpdb\\.set_trace\\s*\\(",
          "\\bdd\\s*\\(\\s*\\$"
        ],
        "except_paths": [
          "test_*",
          "*_test.*",
          "tests/*",
          "*/tests/*",
          "spec/*",
          "*.spec.*",
          "*.test.*",
          "*/fixtures/*",
          "*/__mocks__/*",
          "*.md",
          "*.rst",
          "*.txt"
        ]
      },
      {
        "id": "no-skipped-tests",
        "statement": "Do not disable a test to make a change pass.",
        "severity": "FLAGGED",
        "patterns": [
          "\\b(it|test|describe)\\.skip\\s*\\(",
          "@(unittest\\.)?skip\\b",
          "@pytest\\.mark\\.skip\\b",
          "\\bt\\.Skip\\s*\\("
        ]
      },
      {
        "id": "ask-before-design-changes",
        "statement": "Do not make visual or user-experience design decisions alone. Propose them and wait for a human to choose.",
        "severity": "FLAGGED"
      }
    ]
  }
}
